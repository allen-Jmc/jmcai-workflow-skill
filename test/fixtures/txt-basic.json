{
  "1": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "负面提示词" },
    "inputs": { "text": "blurry", "clip": ["50", 1] }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "正面提示词" },
    "inputs": { "text": "a cat on a chair", "clip": ["50", 1] }
  },
  "3": {
    "class_type": "EmptyLatentImage",
    "_meta": { "title": "尺寸与批次" },
    "inputs": { "width": 512, "height": 768, "batch_size": 1 }
  },
  "4": {
    "class_type": "KSampler",
    "_meta": { "title": "K采样器" },
    "inputs": {
      "seed": 42,
      "steps": 20,
      "cfg": 7,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1,
      "model": ["50", 0],
      "positive": ["2", 0],
      "negative": ["1", 0],
      "latent_image": ["3", 0]
    }
  },
  "5": {
    "class_type": "VAEDecode",
    "_meta": { "title": "VAE解码" },
    "inputs": { "samples": ["4", 0], "vae": ["50", 2] }
  },
  "6": {
    "class_type": "SaveImage",
    "_meta": { "title": "保存图像" },
    "inputs": { "filename_prefix": "JMCAI", "images": ["5", 0] }
  },
  "50": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": { "title": "加载模型" },
    "inputs": { "ckpt_name": "model.safetensors" }
  }
}
